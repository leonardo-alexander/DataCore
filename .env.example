APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=datacore_db
DB_USERNAME=datacore_admin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Data cleaning pipeline (public endpoint, safe to share)
CLEANING_API_URL=https://leonardo-alexander-data-cleaning.hf.space/process

# Demo mode: run every clean inline instead of handing large ones to the queue,
# so the result appears on the page rather than in the activity feed and no queue
# worker needs to be running. Leave off outside demos — a big dataset cleaned this
# way holds the request open for the whole run.
DATACORE_CLEANING_FORCE_SYNC=false

# How long to wait on the cleaning service, which sleeps when idle and needs
# tens of seconds to wake. Raise the inline attempts for a demo if the first
# clean of the day keeps reporting "the cleaning service is starting up".
DATACORE_CLEANING_TIMEOUT=45
DATACORE_CLEANING_ATTEMPTS_INLINE=2
DATACORE_CLEANING_ATTEMPTS_QUEUED=5
DATACORE_CLEANING_RETRY_DELAY=8000

# Seeded admin account (php artisan db:seed)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Economy tuning — defaults live in config/datacore.php
DATACORE_CLEAN2_FEE=
DATACORE_ENTRY_REWARD=
DATACORE_MIN_TOPUP=
DATACORE_MAX_TOPUP=
DATACORE_MIN_WITHDRAWAL=
DATACORE_PLATFORM_FEE_RATE=
DATACORE_USD_RATE=

VITE_APP_NAME="${APP_NAME}"

# Usability testing: skips identity review. Keep false in real deployments.
AUTO_VERIFY_USERS=false
